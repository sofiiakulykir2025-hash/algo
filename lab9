def compute_lps_array(needle):
    m = len(needle)
    lps = [0] * m
    length = 0
    i = 1

    while i < m:
        if needle[i] == needle[length]:
            length += 1
            lps[i] = length
            i += 1
        else:
            if length != 0:
                length = lps[length - 1]
            else:
                lps[i] = 0
                i += 1
    return lps


def kmp_search_static_array(haystack, needle):
    if not needle:
        return []

    n = len(haystack)
    m = len(needle)
    lps = compute_lps_array(needle)
    
    
    result_indices = [0] * n
    count = 0  
    
    i = 0  
    j = 0  
    
    while i < n:
        if needle[j] == haystack[i]:
            i += 1
            j += 1
        
        if j == m:
            start_index = i - j
            
            
            result_indices[count] = start_index
            count += 1  
            j = lps[j - 1]
            
        elif i < n and needle[j] != haystack[i]:
            if j != 0:
                j = lps[j - 1]
            else:
                i += 1
                
    return result_indices[:count]
if __name__ == "__main__":
    text = "Рядок, у якому ми шукаємо. О, ось тут є слово тест, і ось ще один тест!"
    pattern = "тест"
    
    indices = kmp_search_static_array(text, pattern)
    print(f"Знайдено на індексах: {indices}")
