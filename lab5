import os


folder = os.path.dirname(__file__)
input_path = os.path.join(folder, 'input.txt')
output_path = os.path.join(folder, 'output.txt')


f = open(input_path, 'r', encoding='utf-8')
lines = f.readlines()
f.close()


n = int(lines[0].split('#')[0].strip())


start_data = lines[1].split('#')[0].replace(',', ' ').split()
start_x = int(start_data[0])
start_y = int(start_data[1])


target_data = lines[2].split('#')[0].replace(',', ' ').split()
target_x = int(target_data[0])
target_y = int(target_data[1])


row = [2, 2, -2, -2, 1, 1, -1, -1]
col = [-1, 1, 1, -1, 2, -2, 2, -2]

queue = [[start_x, start_y, 0]]
visited = [[start_x, start_y]] 

final_result = -1


index = 0
while index < len(queue):
    curr = queue[index]
    index += 1
    
    x = curr[0]
    y = curr[1]
    dist = curr[2]


    if x == target_x and y == target_y:
        final_result = dist
        break

 
    for i in range(8):
        next_x = x + row[i]
        next_y = y + col[i]

        if 0 <= next_x < n and 0 <= next_y < n:
            
            already_here = False
            for v in visited:
                if v[0] == next_x and v[1] == next_y:
                    already_here = True
                    break
            if not already_here:
                visited.append([next_x, next_y])
                queue.append([next_x, next_y, dist + 1])


out_f = open(output_path, 'w', encoding='utf-8')
out_f.write(str(final_result))
out_f.close()

print(f"Розрахунок завершено! Мінімальна кількість ходів: {final_result}")
print("Результат збережено в output.txt")
