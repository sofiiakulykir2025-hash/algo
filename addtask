print("Введіть кількість працівників (N) та видів пива (B) через пробіл:")
line = input("-> ").split()
n = int(line[0])
b = int(line[1])


prices = [0] * b
print(f"Введіть ціни для {b} видів пива:")
for k in range(b):
    prices[k] = int(input(f"Ціна пива №{k+1}: "))


matrix = [[0] * b for _ in range(n)]

print(f"Введіть вподобання (рядок з {b} літер Y/N):")
for i in range(n):
    row_input = input(f"Працівник №{i+1}: ").upper()
    
    for j in range(b):
        if row_input[j] == 'Y':
            matrix[i][j] = 1
        else:
            matrix[i][j] = 0


min_cost = 1000
best_combination = [0] * b 
count_best = 0             


for i in range(1, 2**b):
    current_cost = 0
    
    
    for beer_idx in range(b):
        if (i >> beer_idx) & 1:
            current_cost = current_cost + prices[beer_idx]
    
    
    if current_cost >= min_cost:
        continue
        
    
    all_happy = True
    for worker_idx in range(n):
        has_beer = False
        for beer_idx in range(b):
            
            if ((i >> beer_idx) & 1) and matrix[worker_idx][beer_idx] == 1:
                has_beer = True
                break
        
        if has_beer == False:
            all_happy = False
            break
            
    
    if all_happy == True:
        min_cost = current_cost
        
        best_combination = [0] * b
        idx = 0
        for beer_idx in range(b):
            if (i >> beer_idx) & 1:
                best_combination[idx] = beer_idx + 1
                idx = idx + 1
        count_best = idx


print("-" * 30)
if min_cost == 1000000000:
    print("Не вдалося знайти варіант для всіх.")
else:
    print("Мінімальна вартість:", min_cost)
    print("Номери видів пива:", end=" ")
    for k in range(count_best):
        print(best_combination[k], end=" ")
    print() 
