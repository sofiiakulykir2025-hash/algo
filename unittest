import unittest


from lab8 import calculate_max_wire

class TestWireLength(unittest.TestCase):
    
    def test_example_1(self):
        self.assertAlmostEqual(calculate_max_wire(2, [3, 3, 3]), 5.656, places=2)

    def test_example_2(self):
        self.assertEqual(calculate_max_wire(100, [1, 1, 1, 1]), 300.0)

    def test_example_3(self):
        self.assertAlmostEqual(calculate_max_wire(4, [100, 2, 100, 2, 100]), 396.32, places=2)

if __name__ == '__main__':
    unittest.main()
