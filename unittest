import unittest
from unittest.mock import patch
from lab5 import solve_tribes_wedding 

class TestWedding(unittest.TestCase):

    @patch('builtins.input')
    def test_example_1(self, mock_input):
        mock_input.side_effect = ["3", "1 2", "2 4", "3 5"]
        self.assertEqual(solve_tribes_wedding(), 4)

    @patch('builtins.input')
    def test_example_2(self, mock_input): 
        mock_input.side_effect = ["5", "1 2", "2 4", "1 3", "3 5", "8 10"]
        self.assertEqual(solve_tribes_wedding(), 6)

    @patch('builtins.input')
    def test_all_in_one_tribe(self, mock_input):
        mock_input.side_effect = ["2", "1 2", "2 3"]
        self.assertEqual(solve_tribes_wedding(), 0)

    @patch('builtins.input')
    def test_only_girls(self, mock_input):
        mock_input.side_effect = ["2", "2 4", "6 8"]
        self.assertEqual(solve_tribes_wedding(), 0)

    @patch('builtins.input')
    def test_two_separate_tribes(self, mock_input):
        mock_input.side_effect = ["2", "1 2", "3 4"]
        self.assertEqual(solve_tribes_wedding(), 2)

if __name__ == '__main__':
    unittest.main(verbosity=2)
