import unittest
from laba5 import  knight_bfs 


class TestKnightPath(unittest.TestCase):

    def test_standard_case(self):
        """Перевірка прикладу з завдання (8x8, 7,0 -> 0,7)"""
        res = knight_bfs(8, 7, 0, 0, 7)
        self.assertEqual(res, 6)

    def test_one_move(self):
        """Перевірка одного прямого ходу"""
        res = knight_bfs(8, 0, 0, 2, 1)
        self.assertEqual(res, 1)

    def test_same_position(self):
        """Перевірка, якщо кінь нікуди не йде"""
        res = knight_bfs(8, 4, 4, 4, 4)
        self.assertEqual(res, 0)

    def test_unreachable(self):
        """Перевірка неможливого шляху на дуже маленькій дошці 2x2"""
        res = knight_bfs(2, 0, 0, 1, 1)
        self.assertEqual(res, -1)

if __name__ == '__main__':
    unittest.main()
